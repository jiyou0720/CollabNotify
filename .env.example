# Discord
DISCORD_TOKEN=
DISCORD_GUILD_ID=
ENABLE_DISCORD_BOT=true

# GitHub
GITHUB_WEBHOOK_SECRET=

# Jira
JIRA_WEBHOOK_SECRET=

# Confluence
CONFLUENCE_WEBHOOK_SECRET=
CONFLUENCE_BASE_URL=https://jehye.atlassian.net
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=

# Review reminders (hours)
REVIEW_REMINDER_HOURS=48
CHANGE_REQUEST_REMINDER_HOURS=48

# Database
DATABASE_URL=sqlite:///database/collabnotify.db
# Optional Docker-specific override. Keep the absolute container path by default.
DOCKER_DATABASE_URL=sqlite:////app/data/collabnotify.db

# DisHost / Pterodactyl (optional)
# Use the primary Allocation port shown in the panel.
DISHOST_PORT=
DISHOST_DATA_DIR=/home/container/data
# pyngrok downloads and keeps the agent at this persistent path.
NGROK_BIN=/home/container/data/ngrok/ngrok
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Logging
LOG_LEVEL=INFO
